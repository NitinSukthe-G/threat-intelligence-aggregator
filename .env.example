# Copy to .env and adjust. Every variable is optional.

# Free abuse.ch Auth-Key (https://auth.abuse.ch) - unlocks URLhaus and ThreatFox.
ABUSECH_AUTH_KEY=

# Protects POST /api/run. Leave empty for open runs (a cooldown still applies).
ADMIN_TOKEN=
RUN_COOLDOWN_SECONDS=300

# Minimum risk score (0-100) for blocklist inclusion. 35 = MEDIUM and above.
BLOCKLIST_MIN_SCORE=35

# Refresh data automatically when the stored results are older than this.
STALE_AFTER_HOURS=12

# How many LOW-risk indicators to keep in ti_results.json (counts are always exact).
STORE_LOW_CAP=2000

# Never block these (comma separated, subdomains included for domains).
ALLOW_DOMAINS=
ALLOW_IPS=

# Set to 1 to include the synthetic feeds in data/samples (STIX/CSV/JSON/TXT demo).
INCLUDE_SAMPLES=0

# Optional TAXII 2.1 collection, e.g. https://taxii.example.org/api1/collections/<id>/
TAXII_COLLECTION_URL=
TAXII_USER=
TAXII_PASSWORD=
